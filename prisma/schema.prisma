generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
}

enum MarriageStatus {
  CURRENT
  DECEASED
  DIVORCED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum UserRole {
  MEMBER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  DECLINED
  DEACTIVATED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  SECURITY
}

enum LogSource {
  ADMIN
  APP
  SYSTEM
}

enum LogCategory {
  AUTH
  ADMIN
  GALLERY
  BODY
  PROFILE
  NAVIGATION
  SYSTEM
  CHRONICLE
}

model Body {
  id            String        @id @default(uuid())
  fullname      String
  sex           Sex
  dateOfBirth   DateTime?
  placeOfBirth  String
  nickname      String?
  phoneNumber   String?
  occupation    String?
  isAlive       Boolean       @default(true)
  deathDate     String?
  maritalStatus MaritalStatus @default(SINGLE)
  notes         String?
  createdBy     String
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  fatherId       String?
  father         Body?        @relation("BodyFather", fields: [fatherId], references: [id])
  fatherChildren Body[]       @relation("BodyFather")

  motherId       String?
  mother         Body?        @relation("BodyMother", fields: [motherId], references: [id])
  motherChildren Body[]       @relation("BodyMother")

  photos     BodyPhoto[]

  spousesAsA BodySpouse[] @relation("SpouseA")
  spousesAsB BodySpouse[] @relation("SpouseB")

  galleryMedia GalleryMedia[]

  profile Profile?

  attributedChronicles    Chronicle[]            @relation("ChronicleAttributedBody")
  taggedInChronicles      ChronicleTaggedBody[]

  @@map("bodies")
}

model BodyPhoto {
  id        String   @id @default(uuid())
  bodyId    String
  body      Body     @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([bodyId, position])
  @@map("body_photos")
}

model BodySpouse {
  id           String         @id @default(uuid())
  bodyIdA      String
  bodyA        Body           @relation("SpouseA", fields: [bodyIdA], references: [id], onDelete: Cascade)
  bodyIdB      String
  bodyB        Body           @relation("SpouseB", fields: [bodyIdB], references: [id], onDelete: Cascade)
  status       MarriageStatus @default(CURRENT)
  marriageDate String?
  endDate      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([bodyIdA, bodyIdB])
  @@map("body_spouses")
}

model Profile {
  id           String     @id
  displayName  String
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(PENDING)
  bodyId       String?    @unique
  body         Body?      @relation(fields: [bodyId], references: [id], onDelete: SetNull)
  phoneNumber  String?    @unique
  profilePhoto String?
  bio          String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("profiles")
}

enum MediaType {
  PHOTO
  DOCUMENT
  VIDEO
}

model GalleryAlbum {
  id           String   @id @default(uuid())
  name         String
  description  String?
  coverImageId String?
  createdBy    String
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  media        GalleryMedia[]

  @@map("gallery_albums")
}

model GalleryTag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  media     GalleryMedia[]

  @@map("gallery_tags")
}

model GalleryMedia {
  id          String    @id @default(uuid())
  url         String
  mediaType   MediaType @default(PHOTO)
  title       String?
  caption     String?
  dateTaken   DateTime?
  isPinned    Boolean   @default(false)
  isAdminOnly Boolean   @default(false)
  hash        String?
  sizeBytes   Int?
  
  albumId     String?
  album       GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  createdBy   String
  updatedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags        GalleryTag[]
  bodies      Body[]

  @@map("gallery_media")
}

model ActivityLog {
  id          String      @id @default(uuid())
  userId      String?
  userDisplay String?
  action      String
  source      LogSource   @default(SYSTEM)
  category    LogCategory
  level       LogLevel    @default(INFO)
  method      String?
  path        String?
  statusCode  Int?
  durationMs  Int?
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([category])
  @@index([level])
  @@index([createdAt])
  @@map("activity_logs")
}

enum ChronicleStatus {
  PENDING
  PUBLISHED
  DECLINED
}

enum ChronicleCategory {
  MIGRATION
  MARRIAGE
  ACHIEVEMENT
  TRADITION
  RECIPE
  FUNNY_STORY
  TRIBUTE
  GENERAL
}

enum ChronicleMediaType {
  IMAGE
  AUDIO
}

model Chronicle {
  id              String              @id @default(uuid())
  title           String
  content         String              @db.Text
  category        ChronicleCategory   @default(GENERAL)
  status          ChronicleStatus     @default(PENDING)

  submittedBy     String
  attributedToType ChronicleAttributionType @default(SELF)
  attributedToBodyId String?
  attributedToBody   Body?            @relation("ChronicleAttributedBody", fields: [attributedToBodyId], references: [id], onDelete: SetNull)
  attributedToLabel  String?

  isEdit          Boolean             @default(false)
  publishedVersionId String?          @unique
  publishedVersion    Chronicle?      @relation("ChronicleRevision", fields: [publishedVersionId], references: [id], onDelete: Cascade)
  pendingEdit         Chronicle?      @relation("ChronicleRevision")

  declineReason   String?

  isPinned        Boolean             @default(false)

  youtubeLinks    String[]            @default([])

  reviewedBy      String?
  reviewedAt      DateTime?

  updatedBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  media           ChronicleMedia[]
  taggedBodies    ChronicleTaggedBody[]
  comments        ChronicleComment[]
  likes           ChronicleLike[]

  @@map("chronicles")
}

enum ChronicleAttributionType {
  SELF
  MEMBER
  ADMIN
  CUSTOM
}

model ChronicleMedia {
  id            String              @id @default(uuid())
  chronicleId   String
  chronicle     Chronicle           @relation(fields: [chronicleId], references: [id], onDelete: Cascade)
  type          ChronicleMediaType
  url           String
  position      Int                 @default(0)
  createdAt     DateTime            @default(now())

  @@unique([chronicleId, position, type])
  @@map("chronicle_media")
}

model ChronicleTaggedBody {
  id            String     @id @default(uuid())
  chronicleId   String
  chronicle     Chronicle  @relation(fields: [chronicleId], references: [id], onDelete: Cascade)
  bodyId        String
  body          Body       @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([chronicleId, bodyId])
  @@map("chronicle_tagged_bodies")
}

model ChronicleComment {
  id            String     @id @default(uuid())
  chronicleId   String
  chronicle     Chronicle  @relation(fields: [chronicleId], references: [id], onDelete: Cascade)
  authorId      String
  content       String     @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("chronicle_comments")
}

model ChronicleLike {
  id            String     @id @default(uuid())
  chronicleId   String
  chronicle     Chronicle  @relation(fields: [chronicleId], references: [id], onDelete: Cascade)
  userId        String
  createdAt     DateTime   @default(now())

  @@unique([chronicleId, userId])
  @@map("chronicle_likes")
}
