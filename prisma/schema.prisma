generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
}

enum MarriageStatus {
  CURRENT
  DECEASED
  DIVORCED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum UserRole {
  MEMBER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  DECLINED
  DEACTIVATED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  SECURITY
}

enum LogSource {
  ADMIN
  APP
  SYSTEM
}

enum LogCategory {
  AUTH
  ADMIN
  GALLERY
  BODY
  PROFILE
  NAVIGATION
  SYSTEM
}

model Body {
  id            String        @id @default(uuid())
  fullname      String
  sex           Sex
  dateOfBirth   DateTime?
  placeOfBirth  String
  nickname      String?
  phoneNumber   String?
  occupation    String?
  isAlive       Boolean       @default(true)
  deathDate     String?
  maritalStatus MaritalStatus @default(SINGLE)
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  fatherId       String?
  father         Body?        @relation("BodyFather", fields: [fatherId], references: [id])
  fatherChildren Body[]       @relation("BodyFather")

  motherId       String?
  mother         Body?        @relation("BodyMother", fields: [motherId], references: [id])
  motherChildren Body[]       @relation("BodyMother")

  photos     BodyPhoto[]

  spousesAsA BodySpouse[] @relation("SpouseA")
  spousesAsB BodySpouse[] @relation("SpouseB")

  galleryMedia GalleryMedia[]

  profile Profile?

  @@map("bodies")
}

model BodyPhoto {
  id        String   @id @default(uuid())
  bodyId    String
  body      Body     @relation(fields: [bodyId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([bodyId, position])
  @@map("body_photos")
}

model BodySpouse {
  id           String         @id @default(uuid())
  bodyIdA      String
  bodyA        Body           @relation("SpouseA", fields: [bodyIdA], references: [id], onDelete: Cascade)
  bodyIdB      String
  bodyB        Body           @relation("SpouseB", fields: [bodyIdB], references: [id], onDelete: Cascade)
  status       MarriageStatus @default(CURRENT)
  marriageDate String?
  endDate      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([bodyIdA, bodyIdB])
  @@map("body_spouses")
}

model Profile {
  id           String     @id
  displayName  String
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(PENDING)
  bodyId       String?    @unique
  body         Body?      @relation(fields: [bodyId], references: [id], onDelete: SetNull)
  phoneNumber  String?    @unique
  profilePhoto String?
  bio          String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("profiles")
}

enum MediaType {
  PHOTO
  DOCUMENT
  VIDEO
}

model GalleryAlbum {
  id           String   @id @default(uuid())
  name         String
  description  String?
  coverImageId String?
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  media        GalleryMedia[]

  @@map("gallery_albums")
}

model GalleryTag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  media     GalleryMedia[]

  @@map("gallery_tags")
}

model GalleryMedia {
  id          String    @id @default(uuid())
  url         String
  mediaType   MediaType @default(PHOTO)
  title       String?
  caption     String?
  dateTaken   DateTime?
  isPinned    Boolean   @default(false)
  isAdminOnly Boolean   @default(false)
  hash        String?
  sizeBytes   Int?
  
  albumId     String?
  album       GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  createdBy   String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags        GalleryTag[]
  bodies      Body[]

  @@map("gallery_media")
}

model ActivityLog {
  id          String      @id @default(uuid())
  userId      String?
  userDisplay String?
  action      String
  source      LogSource   @default(SYSTEM)
  category    LogCategory
  level       LogLevel    @default(INFO)
  method      String?
  path        String?
  statusCode  Int?
  durationMs  Int?
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([category])
  @@index([level])
  @@index([createdAt])
  @@map("activity_logs")
}
