{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/swagger-ui-dist/**",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "api/health.js"
    },
    {
      "src": "/api/health",
      "dest": "api/health.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
